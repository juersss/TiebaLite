<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules xmlns:tools="http://schemas.android.com/tools">
    <cloud-backup>
        <exclude
            domain="sharedpref"
            path="crash.xml" />
        <!-- 账号凭据(bduss/stoken/tbs/cookie)明文存于 Room,绝不随云备份离机 -->
        <exclude
            domain="database"
            path="tblite.db" />
        <exclude
            domain="database"
            path="tblite.db-shm" />
        <exclude
            domain="database"
            path="tblite.db-wal" />
        <!-- 当前账号指针,指向 Room 内账号行;库不带走,指针亦无意义 -->
        <exclude
            domain="sharedpref"
            path="accountData.xml" />
        <!-- 赞踩本地记录与账号/设备的服务端状态绑定,换机恢复只会制造脏记录 -->
        <exclude
            domain="sharedpref"
            path="agree_op_records.xml" />
        <exclude
            domain="file"
            path="error"
            tools:ignore="FullBackupContent" />
    </cloud-backup>
    <device-transfer>
        <exclude
            domain="sharedpref"
            path="crash.xml" />
        <exclude
            domain="database"
            path="tblite.db" />
        <exclude
            domain="database"
            path="tblite.db-shm" />
        <exclude
            domain="database"
            path="tblite.db-wal" />
        <exclude
            domain="sharedpref"
            path="accountData.xml" />
        <exclude
            domain="sharedpref"
            path="agree_op_records.xml" />
        <exclude
            domain="file"
            path="error"
            tools:ignore="FullBackupContent" />
    </device-transfer>
</data-extraction-rules>
