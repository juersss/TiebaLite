<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules xmlns:tools="http://schemas.android.com/tools">
    <cloud-backup>
        <exclude
            domain="sharedpref"
            path="crash.xml" />
        <!-- 账号凭据(bduss/stoken/tbs/cookie)明文存于 Room,绝不随云备份离机 -->
        <exclude
            domain="database"
            path="tblite.db" />
        <exclude
            domain="database"
            path="tblite.db-shm" />
        <exclude
            domain="database"
            path="tblite.db-wal" />
        <!-- 当前账号指针,指向 Room 内账号行;库不带走,指针亦无意义 -->
        <exclude
            domain="sharedpref"
            path="accountData.xml" />
        <!-- 赞踩本地记录与账号/设备的服务端状态绑定,换机恢复只会制造脏记录 -->
        <exclude
            domain="sharedpref"
            path="agree_op_records.xml" />
        <!-- 上面只排掉"不分账号的旧单文件";带 uid 的按账号文件排不掉(规则不支持通配符),
             已整体搬到 files/oprecords/ 下按**目录**排除。
             目录名必须与 OpRecordStore.OP_RECORDS_DIR 一致。 -->
        <exclude
            domain="file"
            path="oprecords"
            tools:ignore="FullBackupContent" />
        <exclude
            domain="file"
            path="error"
            tools:ignore="FullBackupContent" />
    </cloud-backup>
    <device-transfer>
        <exclude
            domain="sharedpref"
            path="crash.xml" />
        <exclude
            domain="database"
            path="tblite.db" />
        <exclude
            domain="database"
            path="tblite.db-shm" />
        <exclude
            domain="database"
            path="tblite.db-wal" />
        <exclude
            domain="sharedpref"
            path="accountData.xml" />
        <exclude
            domain="sharedpref"
            path="agree_op_records.xml" />
        <!-- 同 cloud-backup:按账号分的赞踩记录在 files/oprecords/,按目录排除 -->
        <exclude
            domain="file"
            path="oprecords"
            tools:ignore="FullBackupContent" />
        <exclude
            domain="file"
            path="error"
            tools:ignore="FullBackupContent" />
    </device-transfer>
</data-extraction-rules>
