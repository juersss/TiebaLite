<?xml version="1.0" encoding="utf-8"?>
<full-backup-content xmlns:tools="http://schemas.android.com/tools">
    <exclude
        domain="sharedpref"
        path="crash.xml" />
    <!-- 与 data_extraction_rules.xml 保持同步:凭据库/账号指针/赞踩记录均不备份 -->
    <exclude
        domain="database"
        path="tblite.db" />
    <exclude
        domain="database"
        path="tblite.db-shm" />
    <exclude
        domain="database"
        path="tblite.db-wal" />
    <exclude
        domain="sharedpref"
        path="accountData.xml" />
    <exclude
        domain="sharedpref"
        path="agree_op_records.xml" />
    <!-- 赞踩记录(2026-09-26 起):按账号分文件,文件名带 uid,而备份规则不支持通配符——
         上面只排掉了"不分账号的旧单文件",带 uid 的那些本会被全部带走。
         故整体搬到 files/oprecords/ 下,**按目录排除**。
         目录名必须与 OpRecordStore.OP_RECORDS_DIR 一致。 -->
    <exclude
        domain="file"
        path="oprecords"
        tools:ignore="FullBackupContent" />
    <!-- WebView 数据目录(2026-10-20 补):登录页的 BDUSS 来自 CookieManager，登录态
         实际落在 app_webview/ 的 cookie 库里。库/指针都排了，这里不排就等于
         "数据库不带、会话却可能一起走"。
         app_webview_oksign 是非主进程(:oksign 服务)的 WebView 数据目录——`App.setWebViewPath`
         把进程名收敛成固定后缀 "oksign"（旧写法是完整进程名，含 ':'，无法写精确规则）。
         该目录当前只在 :oksign 进程真的初始化 WebView 时才创建；备份规则不支持通配符，
         故必须按这个确切名字排掉，否则将来的会话/缓存会被一并带走。 -->
    <exclude
        domain="root"
        path="app_webview"
        tools:ignore="FullBackupContent" />
    <exclude
        domain="root"
        path="app_webview_oksign"
        tools:ignore="FullBackupContent" />
    <exclude
        domain="file"
        path="error"
        tools:ignore="FullBackupContent" />
</full-backup-content>
