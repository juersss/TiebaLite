<?xml version="1.0" encoding="utf-8"?>
<full-backup-content xmlns:tools="http://schemas.android.com/tools">
    <exclude
        domain="sharedpref"
        path="crash.xml" />
    <!-- 与 data_extraction_rules.xml 保持同步:凭据库/账号指针/赞踩记录均不备份 -->
    <exclude
        domain="database"
        path="tblite.db" />
    <exclude
        domain="database"
        path="tblite.db-shm" />
    <exclude
        domain="database"
        path="tblite.db-wal" />
    <exclude
        domain="sharedpref"
        path="accountData.xml" />
    <exclude
        domain="sharedpref"
        path="agree_op_records.xml" />
    <exclude
        domain="file"
        path="error"
        tools:ignore="FullBackupContent" />
</full-backup-content>
