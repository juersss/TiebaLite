<?xml version="1.0" encoding="utf-8"?>
<full-backup-content xmlns:tools="http://schemas.android.com/tools">
    <exclude
        domain="sharedpref"
        path="crash.xml" />
    <!-- 与 data_extraction_rules.xml 保持同步:凭据库/账号指针/赞踩记录均不备份 -->
    <exclude
        domain="database"
        path="tblite.db" />
    <exclude
        domain="database"
        path="tblite.db-shm" />
    <exclude
        domain="database"
        path="tblite.db-wal" />
    <exclude
        domain="sharedpref"
        path="accountData.xml" />
    <exclude
        domain="sharedpref"
        path="agree_op_records.xml" />
    <!-- 赞踩记录(2026-09-26 起):按账号分文件,文件名带 uid,而备份规则不支持通配符——
         上面只排掉了"不分账号的旧单文件",带 uid 的那些本会被全部带走。
         故整体搬到 files/oprecords/ 下,**按目录排除**。
         目录名必须与 OpRecordStore.OP_RECORDS_DIR 一致。 -->
    <exclude
        domain="file"
        path="oprecords"
        tools:ignore="FullBackupContent" />
    <exclude
        domain="file"
        path="error"
        tools:ignore="FullBackupContent" />
</full-backup-content>
